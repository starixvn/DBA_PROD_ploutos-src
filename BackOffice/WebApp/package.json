	"scripts": {
		"dev": "webpack --env.DEV --progress --watch --colors --config ./webpack.dev.config.js",
		"start": "webpack-dev-server --env.LOCAL --progress --colors --config ./webpack.dev.config.js",
		"init": "node --max_old_space_size=4096 ./node_modules/webpack-dev-server/bin/webpack-dev-server.js --progress --colors --config ./webpack.kimg.config.js",
		"build": "webpack --env.PROD --progress",
		"build_uat": "webpack --env.UAT --progress --config ./webpack.uat.config.js",
		"build_pagcor": "node --max_old_space_size=4096 ./node_modules/webpack/bin/webpack.js --progress --config ./webpack.pagcor.config.js",
		"clean": "rimraf ./build",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage"
	},
	"engines": {
		"node": ">= 6.0.0",
		"npm": ">= 5.0.0"
	},
	"jest": {
		"setupFiles": [
			"jest-localstorage-mock"
		],
		"setupTestFrameworkScriptFile": "<rootDir>/src/setupTest.js",
		"snapshotSerializers": [
			"enzyme-to-json/serializer"
		],
		"moduleNameMapper": {
			"\\.(css|scss)$": "<rootDir>/src/__mocks__/styleMock.js"
		},
		"testPathIgnorePatterns": [
			"<rootDir>/node_modules/*"
		],
		"modulePathIgnorePatterns": [
			"/node_modules/"
		]
	}
}
