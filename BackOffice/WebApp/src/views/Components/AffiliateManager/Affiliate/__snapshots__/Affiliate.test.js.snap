                "end": 1700,
                "source": Object {
                  "body": "
			query EXTRAQUERY_VIEW {  
				enumRepository{
					AffiliateTypeEnum
					AffiliateStatusTypeEnum
					SettlementPeriodTypeEnum
				}   
				affiliateEarningPlanList(
					count: true,
					paging: {
						offset: 0
						limit: 10
					}
				){
					pagingInfo {offset, limit, totalCount}
					items {
						Id
						EarningPlanName
						BrandId
						CurrencyCode
					}
				}
				bankList(
					count: true,
					paging: {
						offset: 0
						limit: 10
					}
				){
					pagingInfo {offset, limit, totalCount}
					items {
						Id
						BankCode
						BankName
						BrandId
					}
				}
				currencyList(
					count: true,
					paging: {
						offset: 0
						limit: 100
					}
				){
					pagingInfo {offset, limit, totalCount}
					items {
						Id
						CurrencyCode
						BrandId
					}
				}				
				countryList(
					count: true,
					paging: {
						offset: 0
						limit: 100
					}
				){
					pagingInfo {offset, limit, totalCount}
					items {
						Id
						CountryCode
					}
				}
				brandList(
					count: true,
					paging: {
						offset: 0
						limit: 100
					}
				){
					pagingInfo {
						offset
						limit
						totalCount
					}
					items {
						Id
						BrandCode
					}
				}
				iMPlatformList(
					count: true,
					paging: {
						offset: 0
						limit: 100
					}
				){
					pagingInfo {
						offset
						limit
						totalCount
					}
					items {
						Id
						IMPlatformName
						BrandId
					}
				}
				securityQuestionList(
					count: true,
					paging: {
						offset: 0
						limit: 100
					}
				){
					pagingInfo {
						offset
						limit
						totalCount
					}
					items {
						Id
						SecurityQuestionDesc
					}
				}
			}
		",
