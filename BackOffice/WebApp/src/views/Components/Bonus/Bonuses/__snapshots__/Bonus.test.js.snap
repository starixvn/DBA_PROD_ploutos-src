                    "source": Object {
                      "body": "
            query EXTRAQUERY_VIEW {
				enumRepository {
					BonusTypeEnum
					BonusValueTypeEnum
					BonusFactorBasisTypeEnum
				}
                currencyList(
					
	count: true,
	paging: {
		offset: 0,
		limit: 10
	}	

                ){
					pagingInfo {
	offset,
	limit,
	totalCount
}
                    items {
                        Id
                        CurrencyCode
                    }
                }
                brandList(
					
	count: true,
	paging: {
		offset: 0,
		limit: 10
	}	

                ){
					pagingInfo {
	offset,
	limit,
	totalCount
}
                    items {
                        Id
                        BrandCode
                    }
				}
				vIPLevelList(
					
	count: true,
	paging: {
		offset: 0,
		limit: 10
	}	

                ){
					pagingInfo {
	offset,
	limit,
	totalCount
}
                    items {
                        Id
						VipLevelCode
						BrandId
                    }
                }
            }
        ",
                      "locationOffset": Object {
                        "column": 1,
