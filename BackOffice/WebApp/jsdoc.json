{
	"tags": {
		"allowUnknownTags": true
	},
	"linenums": true,
	"source": {
		"include": [
			"./src/"
		],
		"exclude": [
			".git",
			".meteor",
			"node_modules"
		],
		"includePattern": ".+\\.js(x|doc)?$"
	},
	"plugins": ["plugins/markdown"],
	"opts": {
		"encoding": "utf8",
		"template": "./node_modules/tui-jsdoc-template",
		"destination": "./docs/",
		"recurse": true,
		"verbose": true
	},
	"markdown": {
		"parser": "gfm",
		"hardwrap": true
	},
	"templates": {
		"cleverLinks": false,
		"monospaceLinks": false,
		"default": {
			"outputSourceFiles": true,
			"includeDate": false
		},
		"name": "Blueberry Dev Docs",
		"footerText": "Copyright 2018",
		"logo": {
			"url": ""
		}
	}
}